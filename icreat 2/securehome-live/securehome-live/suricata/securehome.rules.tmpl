# ============================================================================
#  SecureHome detection rules  (sid range 9000000+)
#  This is a TEMPLATE. setup.sh renders it into securehome.rules with the
#  values from config.dhruv.env substituted in. Do not edit the rendered file.
# ============================================================================

# --- 1. RECONNAISSANCE: port scan ------------------------------------------
# nmap -p- produces many SYNs from one source in a short window.
alert tcp any any -> $HOME_NET any ( \
    msg:"SECUREHOME Recon - TCP port scan detected"; \
    flags:S; flow:to_server; \
    threshold: type both, track by_src, count ${SCAN_COUNT}, seconds ${SCAN_SECONDS}; \
    classtype:attempted-recon; \
    metadata: securehome stage recon; \
    sid:9000001; rev:1; )

# --- 2. COMPROMISE: Mirai-pattern credential brute-force -------------------
# Many connections to the ESP32 login port from one source = brute-force.
alert tcp any any -> $HOME_NET ${BRUTEFORCE_PORT} ( \
    msg:"SECUREHOME Compromise - Mirai-pattern brute-force on login service"; \
    flow:to_server; \
    threshold: type both, track by_src, count ${BRUTE_COUNT}, seconds ${BRUTE_SECONDS}; \
    classtype:attempted-admin; \
    metadata: securehome stage compromise; \
    sid:9000002; rev:1; )

# --- 3. C2 BEACON: outbound to a known-bad / blocklisted host --------------
# The compromised device phones home. Matches the staged C2 IP that setup.sh
# placed in the blocklist. This is the alert the active-response daemon acts on.
alert ip $HOME_NET any -> ${STAGED_C2_IP} any ( \
    msg:"SECUREHOME C2 - Outbound beacon to blocklisted host"; \
    flow:to_server; \
    classtype:command-and-control; \
    metadata: securehome stage c2 respond; \
    sid:9000003; rev:1; )

# --- 4. (Advisory / Phase C) ARP anomaly -----------------------------------
# Suricata 7 decodes ARP; this logs gratuitous-reply floods seen during
# arpspoof. Advisory only — logged, not blocked.
alert arp any any -> any any ( \
    msg:"SECUREHOME Advisory - Possible ARP spoofing"; \
    threshold: type both, track by_src, count 20, seconds 5; \
    metadata: securehome stage advisory; \
    sid:9000004; rev:1; )
