alert tcp any any -> $HOME_NET any (msg:"SECUREHOME Recon - TCP port scan detected"; flags:S; flow:to_server; threshold: type both, track by_src, count 30, seconds 5; classtype:attempted-recon; sid:9000001; rev:1;)
alert tcp any any -> $HOME_NET 23 (msg:"SECUREHOME Compromise - Mirai-pattern brute-force"; flow:to_server; threshold: type both, track by_src, count 20, seconds 10; classtype:attempted-admin; sid:9000002; rev:1;)
alert ip $HOME_NET any -> 192.168.50.200 any (msg:"SECUREHOME C2 - Outbound beacon to blocklisted host"; flow:to_server; classtype:command-and-control; sid:9000003; rev:1;)
