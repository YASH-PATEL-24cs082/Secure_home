# ============================================================================
#  SecureHome — LAB CONFIGURATION   (fill this in — this is the ONLY file
#  you need to edit before the demo)
#
#  Owner: Dhruv
#  Every script, rule and the dashboard read their values from here.
#  Format: KEY=VALUE  (no spaces around =, no quotes needed)
#  Bash:   set -a; source config.dhruv.env; set +a
#  Python: backend reads it automatically
# ============================================================================

# ----- 1. CAPTURE / NETWORK -------------------------------------------------
# The interface Suricata listens on. On a laptop demo this is often the VM's
# LAN adapter (e.g. eth0, ens33). Find it with:  ip -br a
CAPTURE_IFACE=eth0

# Your isolated lab subnet (matches the SecureHome site: 192.168.50.0/24)
LAN_CIDR=192.168.50.0/24
HOME_NET=192.168.50.0/24

# The gateway box that runs Suricata + nftables (this machine)
GATEWAY_IP=192.168.50.1

# ----- 2. DEVICES ON THE LAB SEGMENT ---------------------------------------
# Used by the dashboard to turn raw IPs into readable device names.
# Get MACs/IPs from:  sudo arp-scan --localnet

CAMERA_IP=192.168.50.20
CAMERA_MAC=aa:bb:cc:11:22:33
CAMERA_NAME=Tuya Wi-Fi Camera

ESP32_IP=192.168.50.30
ESP32_MAC=aa:bb:cc:44:55:66
ESP32_NAME=ESP32 Test Node

PLUG_IP=192.168.50.40
PLUG_MAC=aa:bb:cc:77:88:99
PLUG_NAME=Tuya Smart Plug

# ----- 3. ATTACKER ----------------------------------------------------------
# The Kali box you run the attack from.
ATTACKER_IP=192.168.50.100
ATTACKER_NAME=Kali (attacker)

# ----- 4. STAGED C2 / BLOCKLISTED IP ---------------------------------------
# The "botnet command-and-control" address the compromised device beacons to.
# THIS MUST BE AN IP YOU CONTROL (a second VM/Pi) OR AN UNROUTED TEST IP.
# NEVER a real, live malicious host. setup.sh puts this into the blocklist so
# Suricata flags it and the responder drops it.
STAGED_C2_IP=192.168.50.200
STAGED_C2_PORT=80

# ----- 5. BRUTE-FORCE TARGET (the "compromise" step) -----------------------
# Per the SecureHome design, the Mirai-pattern brute-force runs against the
# ESP32's deliberately-weak telnet/SSH service — NOT the Tuya camera (which is
# cloud-bound and exposes no login to brute-force).
BRUTEFORCE_TARGET=192.168.50.30
BRUTEFORCE_SERVICE=telnet          # telnet | ssh
BRUTEFORCE_PORT=23

# ----- 6. DETECTION THRESHOLDS (tune if it under/over-fires) ----------------
SCAN_COUNT=30                      # SYNs from one src within...
SCAN_SECONDS=5                     # ...this window => port-scan alert
BRUTE_COUNT=20                     # connections to the login port within...
BRUTE_SECONDS=10                   # ...this window => brute-force alert

# ----- 7. ACTIVE RESPONSE (Architecture B) ---------------------------------
# On a confirmed C2 match, the responder adds an nftables drop rule for a
# limited time (TTL), matching the site's "auto-block ... with a TTL".
NFT_TABLE=securehome
NFT_CHAIN=block
BLOCK_TTL_SECONDS=120

# ----- 8. DASHBOARD ---------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
